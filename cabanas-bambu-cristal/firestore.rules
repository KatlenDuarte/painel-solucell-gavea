rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Conteúdo e calendário: todos leem, só a proprietária (logada) altera
    match /site/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Fotos guardadas no Firestore (quando o Storage não está ativo)
    match /media/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Pré-reservas: visitantes só podem criar; a proprietária lê e gerencia
    match /requests/{id} {
      allow create: if request.resource.data.status == "new"
                    && request.resource.data.name is string
                    && request.resource.data.name.size() < 120
                    && request.resource.data.notes.size() < 2000;
      allow read, update, delete: if request.auth != null;
    }
  }
}
